{
  "brand": {
    "comment": "brand anchors: the original ral codes, do not modify",
    "ral7016": { "hex": "#383E42", "name": "anthracite grey" },
    "ral9005": { "hex": "#0A0A0A", "name": "jet black" },
    "ral9016": { "hex": "#F1F0EA", "name": "traffic white" },
    "ral2004": { "hex": "#E75B12", "name": "pure orange" },
    "ral5005": { "hex": "#005387", "name": "signal blue" }
  },

  "ramps": {
    "ramp_comments": {
      "gray": "grey ramp (hue consistently derived from ral 7016, h≈204°)",
      "orange": "orange ramp (derived from ral 2004, h≈21°)",
      "red": "red ramp (h=0) — ramps are full scales; roles pick from them",
      "blue": "blue ramp (derived from ral 5005, h≈203°) — info/status only, never an accent"
    },
    "gray": {
      "50": "#F7F7F8", "100": "#EFF0F1", "200": "#E1E3E5", "300": "#C9CDCF",
      "400": "#A2AAAF", "500": "#7D8991", "600": "#606A71", "700": "#495055",
      "800": "#383E42", "850": "#2C3032", "900": "#212426", "950": "#131516"
    },
    "orange": {
      "50": "#F9F2EE", "100": "#F6E9E2", "200": "#F1D7C9", "300": "#EBBEA5",
      "400": "#FF8A3D", "500": "#E75B12", "600": "#B94F15", "700": "#954216",
      "800": "#723615", "900": "#4F2712", "950": "#391D0E"
    },
    "red": {
      "50": "#F9F0F0", "100": "#F6E4E4", "200": "#F59A9A", "300": "#E08585",
      "400": "#DA6262", "500": "#CC3E3E", "600": "#A33030", "700": "#862727",
      "800": "#5C2323", "900": "#3A1A1A", "950": "#2E1414"
    },
    "blue": {
      "50": "#F0F6F9", "100": "#E4EFF7", "200": "#AAD4EE", "300": "#7AC0EB",
      "400": "#45ACED", "500": "#1299ED", "600": "#0D7EC5", "700": "#0766A2",
      "800": "#005387", "900": "#083754", "950": "#092434"
    }
  },
  "ramp_notes": {
    "gray:800": "= ral 7016",
    "orange:400": "dark mode accent",
    "orange:500": "= ral 2004, brand orange",
    "orange:600": "hover & pressed on light backgrounds",
    "orange:700": "link text on light (6.8:1)",
    "red:200": "dark mode error accent",
    "red:600": "light mode error accent",
    "red:900": "dark mode error container",
    "blue:100": "light mode info container",
    "blue:200": "dark mode info accent, also on-info-container",
    "blue:800": "= ral 5005, brand blue, light mode info accent",
    "blue:900": "light on-info-container, dark info container",
    "blue:950": "dark mode on-info"
  },

  "roles": [
    {
      "comment": "primary = the brand's black action color (buttons, switches, sliders)",
      "tokens": {
        "primary":              { "light": "ral:9005", "dark": "ral:9016" },
        "on-primary":           { "light": "ral:9016", "dark": "ral:9005" },
        "primary-container":    { "light": "ral:7016", "dark": "gray:850" },
        "on-primary-container": { "light": "ral:9016", "dark": "ral:9016" },
        "primary-fixed":        { "light": "ral:7016", "dark": null },
        "on-primary-fixed":     { "light": "ral:9016", "dark": null },
        "primary-fixed-dim":    { "light": "gray:700", "dark": null },
        "on-primary-fixed-variant": { "light": "ral:9016", "dark": null }
      }
    },
    {
      "comment": "secondary = muted grey for less prominent actions",
      "tokens": {
        "secondary":              { "light": "gray:700", "dark": "gray:400" },
        "on-secondary":           { "light": "ral:9016", "dark": "gray:950" },
        "secondary-container":    { "light": "gray:200", "dark": "gray:700" },
        "on-secondary-container": { "light": "gray:900", "dark": "gray:100" },
        "secondary-fixed":        { "light": "gray:200", "dark": null },
        "on-secondary-fixed":     { "light": "gray:900", "dark": null },
        "secondary-fixed-dim":    { "light": "gray:300", "dark": null },
        "on-secondary-fixed-variant": { "light": "gray:900", "dark": null }
      }
    },
    {
      "comment": "tertiary = the orange cta / accent — use sparingly (see readme)",
      "tokens": {
        "tertiary":              { "light": "ral:2004", "dark": "orange:400" },
        "on-tertiary":           { "light": "ral:9005", "dark": "ral:9005" },
        "tertiary-container":    { "light": "orange:100", "dark": "orange:900" },
        "on-tertiary-container": { "light": "orange:800", "dark": "orange:300" },
        "tertiary-fixed":        { "light": "ral:2004", "dark": null },
        "on-tertiary-fixed":     { "light": "ral:9005", "dark": null },
        "tertiary-fixed-dim":    { "light": "orange:600", "dark": null },
        "on-tertiary-fixed-variant": { "light": "ral:9005", "dark": null }
      }
    },
    {
      "comment": "error — on the red ramp (red:600/100 light, red:200/900 dark)",
      "tokens": {
        "error":              { "light": "red:600", "dark": "red:200" },
        "on-error":           { "light": "ral:9016", "dark": "red:900" },
        "error-container":    { "light": "red:100", "dark": "red:900" },
        "on-error-container": { "light": "red:800", "dark": "red:200" }
      }
    },
    {
      "comment": "background & surfaces",
      "tokens": {
        "background":              { "light": "#FFFFFF", "dark": "gray:950" },
        "on-background":           { "light": "ral:9005", "dark": "ral:9016" },
        "surface":                 { "light": "#FFFFFF", "dark": "gray:950" },
        "on-surface":              { "light": "ral:9005", "dark": "ral:9016" },
        "surface-variant":         { "light": "ral:9016", "dark": "gray:900" },
        "on-surface-variant":      { "light": "gray:600", "dark": "gray:400" },
        "surface-dim":             { "light": "gray:100", "dark": "ral:9005" },
        "surface-bright":          { "light": "#FFFFFF", "dark": "gray:900" },
        "surface-container-lowest":{ "light": "#FFFFFF", "dark": "ral:9005" },
        "surface-container-low":   { "light": "gray:50",  "dark": "gray:950" },
        "surface-container":       { "light": "ral:9016", "dark": "gray:900" },
        "surface-container-high":  { "light": "gray:100", "dark": "gray:850" },
        "surface-container-highest": { "light": "gray:200", "dark": "gray:800" }
      }
    },
    {
      "comment": "outlines",
      "tokens": {
        "outline":         { "light": "gray:500", "dark": "gray:500" },
        "outline-variant": { "light": "gray:200", "dark": "#3A3F42" }
      }
    },
    {
      "comment": "inverse (snackbars, tooltips)",
      "tokens": {
        "inverse-surface":     { "light": "gray:900", "dark": "ral:9016" },
        "inverse-on-surface":  { "light": "ral:9016", "dark": "gray:900" },
        "inverse-primary":     { "light": "orange:400", "dark": "ral:2004" }
      }
    },
    {
      "comment": "misc",
      "tokens": {
        "shadow": { "light": "ral:9005", "dark": "ral:9005", "kt": false },
        "scrim":  { "light": "ral:9005", "dark": "ral:9005" },
        "surface-tint": { "light": "ral:9005", "dark": "ral:9016", "css": false }
      }
    }
  ],

  "shapes": {
    "comment": "corner radii in dp/px, m3 scale; full = pill",
    "none": 0, "extra-small": 4, "small": 8, "medium": 12,
    "large": 16, "extra-large": 28, "full": null
  },

  "elevation": {
    "comment": "shadow elevation levels in dp/px",
    "level0": 0, "level1": 1, "level2": 3, "level3": 6, "level4": 8, "level5": 12
  },

  "state_layers": {
    "comment": "overlay opacity per state, m3 spec",
    "hover": 0.08, "focus": 0.12, "pressed": 0.16, "dragged": 0.16
  },

  "focus_ring": {
    "comment": "focus indicator: 2px outline token, offset 2px",
    "width": 2, "offset": 2, "color": "outline"
  },
  "role_usage": {
    "primary / on-primary": "buttons, switches, sliders",
    "primary-container / on-": "tonal containers, selected states",
    "tertiary / on-tertiary": "the orange cta — the only orange button",
    "tertiary-container / on-": "orange-tinted chips, highlights",
    "surface / on-surface": "backgrounds / text",
    "surface-container-highest": "elevated cards, sheets",
    "surface-variant / on-": "input fills, secondary text",
    "outline / outline-variant": "input borders / decorative lines",
    "error / on-error": "error states",
    "success / on-success": "confirmations, online states",
    "warning / on-warning": "cautions, degraded states",
    "info / on-info": "neutral hints, tips (signal blue, ral 5005)",
    "link": "text links on body surfaces",
    "inverse-*": "snackbars, tooltips (defined)"
  },

  "semantic": [
    {
      "comment": "status colors — tinted container + dark text on light, solid accent + dark text on dark (readme rule 8); info uses the signal blue (ral 5005)",
      "tokens": {
        "success":              { "light": "#256E43", "dark": "#8FD5A8" },
        "on-success":           { "light": "ral:9016", "dark": "#0F2A19" },
        "success-container":    { "light": "#D9EDE0", "dark": "#1D4630" },
        "on-success-container": { "light": "#1E5330", "dark": "#C4EBD2" },
        "warning":              { "light": "#8A5A00", "dark": "#FFD48A" },
        "on-warning":           { "light": "ral:9016", "dark": "#2E2000" },
        "warning-container":    { "light": "#F7ECD0", "dark": "#46380F" },
        "on-warning-container": { "light": "#5C3F00", "dark": "#FFE1A0" },
        "info":                 { "light": "blue:800", "dark": "blue:200" },
        "on-info":              { "light": "ral:9016", "dark": "blue:950" },
        "info-container":       { "light": "blue:100", "dark": "blue:900" },
        "on-info-container":    { "light": "blue:900", "dark": "blue:200" }
      }
    },
    {
      "comment": "links — orange-700 on light (6.8:1), orange-400 on dark (7.8:1); hover darkens one step",
      "tokens": {
        "link":       { "light": "orange:700", "dark": "orange:400" },
        "link-hover": { "light": "orange:800", "dark": "orange:300" }
      }
    }
  ],

  "typography": {
    "comment": "dejavu sans typescale, m3 roles and sizes; family swappable via one variable",
    "family": "'DejaVu Sans', system-ui, sans-serif",
    "family_mono": "'DejaVu Sans Mono', ui-monospace, monospace",
    "styles": {
      "display-large":  { "size": 57, "line": 64, "weight": 400, "tracking": -0.25 },
      "display-medium": { "size": 45, "line": 52, "weight": 400, "tracking": 0 },
      "display-small":  { "size": 36, "line": 44, "weight": 400, "tracking": 0 },
      "headline-large":  { "size": 32, "line": 40, "weight": 400, "tracking": 0 },
      "headline-medium": { "size": 28, "line": 36, "weight": 400, "tracking": 0 },
      "headline-small":  { "size": 24, "line": 32, "weight": 400, "tracking": 0 },
      "title-large":   { "size": 22, "line": 28, "weight": 400, "tracking": 0 },
      "title-medium":  { "size": 16, "line": 24, "weight": 500, "tracking": 0.15 },
      "title-small":   { "size": 14, "line": 20, "weight": 500, "tracking": 0.1 },
      "body-large":   { "size": 16, "line": 24, "weight": 400, "tracking": 0.5 },
      "body-medium":  { "size": 14, "line": 20, "weight": 400, "tracking": 0.25 },
      "body-small":   { "size": 12, "line": 16, "weight": 400, "tracking": 0.4 },
      "label-large":  { "size": 14, "line": 20, "weight": 500, "tracking": 0.1 },
      "label-medium": { "size": 12, "line": 16, "weight": 500, "tracking": 0.5 },
      "label-small":  { "size": 11, "line": 16, "weight": 500, "tracking": 0.5 }
    }
  }
}
